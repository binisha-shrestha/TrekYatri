<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trekyatri.controller.TouristController">


    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-container">

        <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
        </padding>
    </HBox>



    <VBox spacing="20.0" styleClass="main-content">
        <children>
            <!-- Tourist Form Section -->
            <VBox spacing="15.0" styleClass="form-section">
                <children>
                    <Label styleClass="section-title" text="AttractionManagment">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>

                    <GridPane hgap="15.0" styleClass="form-grid" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>
                            <!-- Row 1 -->
                            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <children>
                                    <Label fx:id="idLabel" prefHeight="25.0" prefWidth="83.0" styleClass="form-label" text="Attraction ID" />
                                    <TextField fx:id="touristIdField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <children>
                                    <Label fx:id="nameLabel" styleClass="form-label" text="Name" />
                                    <TextField fx:id="touristNameField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <children>
                                    <Label fx:id="nationalityLabel" styleClass="form-label" text="Description" />
                                    <TextField fx:id="touristNationalityField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <!-- Row 2 -->
                            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <children>
                           <Label text="Altitude" />
                           <TextField />
                        </children></VBox>
                        </children>
                    </GridPane>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Button fx:id="addButton" onAction="#onAddTourist" styleClass="primary-button" text="Add Attractions" />
                            <Button fx:id="updateButton" onAction="#onUpdateTourist" styleClass="secondary-button" text="Update Attractions" />
                            <Button fx:id="deleteButton" onAction="#onDeleteTourist" styleClass="danger-button" text="Delete Attractions" />
                            <Button fx:id="clearButton" onAction="#onClearFields" styleClass="neutral-button" text="Altitude Check" />
                        </children>
                    </HBox>
                </children>
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
            </VBox>

            <!-- Search Section -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="search-section">
                <children>
                    <Label fx:id="searchLabel" styleClass="form-label" text="Discount Information" />
                    <TextField fx:id="searchField" onKeyReleased="#onSearchKeyReleased" promptText="Get upto 15%discount on Dashain occasion!" styleClass="search-textfield" HBox.hgrow="ALWAYS" />
                </children>
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                </padding>
            </HBox>

            <!-- Tourist Table Section -->
            <VBox spacing="10.0" styleClass="table-section" VBox.vgrow="ALWAYS">
                <children>
                    <Label styleClass="section-title" text="Attraction List">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <TableView fx:id="touristTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="ID" prefWidth="100.0" />
                            <TableColumn fx:id="touristNameColumn" prefWidth="150.0" text="Name" />
                            <TableColumn fx:id="touristNationalityColumn" prefWidth="120.0" text="Description" />
                            <TableColumn fx:id="touristContactColumn" prefWidth="130.0" text="Altitude" />
                        </columns>
                    </TableView>
                </children>
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                </padding>
            </VBox>
        </children>
    </VBox>
   <Button layoutX="507.0" layoutY="22.0" mnemonicParsing="false" text="Dashboard" />


    <stylesheets>
        <URL value="@../css/management-styles.css">
        </URL>
    </stylesheets>



</AnchorPane>
