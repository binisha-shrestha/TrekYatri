<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trekyatri.controller.ReportController">

    <VBox spacing="20.0" styleClass="main-content" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <children>
                    <Label styleClass="section-title" text="Analytics Dashboard">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>
                    <Button onAction="#onRefreshData" styleClass="primary-button" text="Refresh Data" />
                </children>
            </HBox>

            <!-- Statistics Cards -->
            <GridPane hgap="15.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <children>
                    <!-- Row 1 -->
                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <children>
                            <Label fx:id="totalTouristsLabel" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Total Tourists" />
                        </children>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <children>
                            <Label fx:id="totalGuidesLabel" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Total Guides" />
                        </children>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <children>
                            <Label fx:id="totalAttractionsLabel" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Total Attractions" />
                        </children>
                    </VBox>

                    <!-- Row 2 -->
                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <children>
                            <Label fx:id="totalBookingsLabel" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Total Bookings" />
                        </children>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <children>
                            <Label fx:id="totalRevenueLabel" styleClass="stat-value" text="$0.00" />
                            <Label styleClass="stat-label" text="Total Revenue" />
                        </children>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <children>
                            <Label fx:id="popularAttractionLabel" styleClass="stat-value" text="None" />
                            <Label styleClass="stat-label" text="Most Popular Attraction" />
                        </children>
                    </VBox>
                </children>
            </GridPane>

            <!-- Charts Section -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                <children>
                    <!-- Pie Chart -->
                    <VBox spacing="10.0" styleClass="chart-container" HBox.hgrow="SOMETIMES">
                        <children>
                            <Label styleClass="chart-title" text="Attraction Types Distribution" />
                            <PieChart fx:id="attractionTypeChart" VBox.vgrow="ALWAYS" />
                        </children>
                    </VBox>

                    <!-- Bar Chart -->
                    <VBox spacing="10.0" styleClass="chart-container" HBox.hgrow="SOMETIMES">
                        <children>
                            <Label styleClass="chart-title" text="Monthly Bookings" />
                            <BarChart fx:id="monthlyBookingsChart" VBox.vgrow="ALWAYS">
                                <xAxis>
                                    <CategoryAxis />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis />
                                </yAxis>
                            </BarChart>
                        </children>
                    </VBox>
                </children>
            </HBox>

            <!-- Revenue Chart -->
            <VBox spacing="10.0" styleClass="chart-container">
                <children>
                    <Label styleClass="chart-title" text="Monthly Revenue Trend" />
                    <LineChart fx:id="revenueChart" prefHeight="200.0">
                        <xAxis>
                            <CategoryAxis />
                        </xAxis>
                        <yAxis>
                            <NumberAxis />
                        </yAxis>
                    </LineChart>
                </children>
            </VBox>
        </children>
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
    </VBox>
</AnchorPane>
