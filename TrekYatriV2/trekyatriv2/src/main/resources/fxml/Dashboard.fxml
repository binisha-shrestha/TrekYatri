<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="dashboard-container"
            xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.trekyatri.controller.DashboardController">

    <VBox spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <!-- Header Section -->
            <VBox alignment="CENTER" spacing="10.0">
                <children>
                    <Label fx:id="titleLabel" styleClass="dashboard-title" text="TrekYatri Dashboard">
                        <font>
                            <Font name="System Bold" size="36.0" />
                        </font>
                    </Label>
                    <Label fx:id="taglineLabel" styleClass="dashboard-tagline"
                           text="Welcome to Nepal Tourism Management System">
                        <font>
                            <Font size="16.0" />
                        </font>
                    </Label>
                </children>
            </VBox>

            <!-- Main Menu Grid -->
            <GridPane alignment="CENTER" hgap="20.0" vgap="20.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <children>
                    <!-- Row 1 -->
                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <children>
                            <Button fx:id="touristManagementButton" maxWidth="1.7976931348623157E308"
                                    onAction="#handleTouristManagementButton" styleClass="primary-button"
                                    text="Tourist Management">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Button>
                            <Label text="Manage tourist registrations and information"
                                   styleClass="stat-label" textAlignment="CENTER" wrapText="true" />
                        </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <children>
                            <Button fx:id="guideManagementButton" maxWidth="1.7976931348623157E308"
                                    onAction="#handleGuideManagementButton" styleClass="secondary-button"
                                    text="Guide Management">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Button>
                            <Label text="Manage tour guides and their specializations"
                                   styleClass="stat-label" textAlignment="CENTER" wrapText="true" />
                        </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <children>
                            <Button fx:id="attractionManagementButton" maxWidth="1.7976931348623157E308"
                                    onAction="#handleAttractionManagementButton" styleClass="primary-button"
                                    text="Attraction Management">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Button>
                            <Label text="Manage tourist attractions and destinations"
                                   styleClass="stat-label" textAlignment="CENTER" wrapText="true" />
                        </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>

                    <!-- Row 2 -->
                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <children>
                            <Button fx:id="bookingButton" maxWidth="1.7976931348623157E308"
                                    onAction="#handleBookingButton" styleClass="secondary-button"
                                    text="Booking Management">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Button>
                            <Label text="Handle bookings and reservations"
                                   styleClass="stat-label" textAlignment="CENTER" wrapText="true" />
                        </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <children>
                            <Button fx:id="tourPackagesButton" maxWidth="1.7976931348623157E308"
                                    onAction="#handleTourPackagesButton" styleClass="primary-button"
                                    text="Tour Packages">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Button>
                            <Label text="Browse and manage tour packages"
                                   styleClass="stat-label" textAlignment="CENTER" wrapText="true" />
                        </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card"
                          GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <children>
                            <Button fx:id="reportButton" maxWidth="1.7976931348623157E308"
                                    onAction="#handleReportButton" styleClass="secondary-button"
                                    text="Reports and Analytics">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Button>
                            <Label text="View reports and system analytics"
                                   styleClass="stat-label" textAlignment="CENTER" wrapText="true" />
                        </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </children>
            </GridPane>

            <!-- Footer Info -->
            <VBox alignment="CENTER" spacing="10.0">
                <children>
                    <Separator />
                    <Label text="🏔️ Discover the Beauty of Nepal 🏔️" styleClass="dashboard-tagline">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                </children>
            </VBox>
        </children>
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>
    </VBox>
</AnchorPane>
