<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trekyatri.controller.GuideController">

    <VBox spacing="20.0" styleClass="main-content" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <!-- Guide Form Section -->
            <VBox spacing="15.0" styleClass="form-section">
                <children>
                    <Label styleClass="section-title" text="Guide Information">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>

                    <GridPane hgap="15.0" styleClass="form-grid" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>
                            <!-- Row 1 -->
                            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="form-label" text="Guide ID" />
                                    <TextField fx:id="guideIdField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="form-label" text="Name" />
                                    <TextField fx:id="guideNameField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="form-label" text="Languages (comma separated)" />
                                    <TextField fx:id="languagesField" styleClass="form-textfield"
                                               promptText="English, Nepali, Hindi" />
                                </children>
                            </VBox>

                            <!-- Row 2 -->
                            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <children>
                                    <Label styleClass="form-label" text="Experience (Years)" />
                                    <TextField fx:id="experienceField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <children>
                                    <Label styleClass="form-label" text="Contact" />
                                    <TextField fx:id="contactField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <children>
                                    <Label styleClass="form-label" text="Email" />
                                    <TextField fx:id="emailField" styleClass="form-textfield" />
                                </children>
                            </VBox>

                            <!-- Row 3 -->
                            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <children>
                                    <Label styleClass="form-label" text="Specialization" />
                                    <TextField fx:id="specializationField" styleClass="form-textfield"
                                               promptText="High Altitude Trekking, Cultural Tours, etc." />
                                </children>
                            </VBox>
                        </children>
                    </GridPane>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Button fx:id="addButton" onAction="#onAddGuide" styleClass="primary-button" text="Add Guide" />
                            <Button fx:id="updateButton" onAction="#onUpdateGuide" styleClass="secondary-button" text="Update Guide" />
                            <Button fx:id="deleteButton" onAction="#onDeleteGuide" styleClass="danger-button" text="Delete Guide" />
                            <Button fx:id="clearButton" onAction="#onClearFields" styleClass="neutral-button" text="Clear Fields" />
                        </children>
                    </HBox>
                </children>
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
            </VBox>

            <!-- Search Section -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="search-section">
                <children>
                    <Label styleClass="form-label" text="Search:" />
                    <TextField fx:id="searchField" onKeyReleased="#onSearchKeyReleased"
                               promptText="Search by name, specialization, or contact..."
                               styleClass="search-textfield" HBox.hgrow="ALWAYS" />
                </children>
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                </padding>
            </HBox>

            <!-- Guide Table Section -->
            <VBox spacing="10.0" styleClass="table-section" VBox.vgrow="ALWAYS">
                <children>
                    <Label styleClass="section-title" text="Guide List">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <TableView fx:id="guideTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="guideIdColumn" prefWidth="100.0" text="ID" />
                            <TableColumn fx:id="guideNameColumn" prefWidth="150.0" text="Name" />
                            <TableColumn fx:id="languagesColumn" prefWidth="150.0" text="Languages" />
                            <TableColumn fx:id="experienceColumn" prefWidth="100.0" text="Experience" />
                            <TableColumn fx:id="contactColumn" prefWidth="130.0" text="Contact" />
                            <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email" />
                            <TableColumn fx:id="specializationColumn" prefWidth="180.0" text="Specialization" />
                        </columns>
                    </TableView>
                </children>
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                </padding>
            </VBox>
        </children>
    </VBox>
</AnchorPane>
